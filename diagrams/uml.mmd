classDiagram
    %% PawPal+ — pet care planning assistant
    %% Owner sets the time window; tasks belong to pets; Schedule plans the day.

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
        +rank() int
    }

    class Frequency {
        <<enumeration>>
        DAILY
        WEEKLY
        ONCE
    }

    class Owner {
        +str name
        +time day_start
        +time day_end
        +list~Pet~ pets
        +add_pet(pet Pet) None
        +available_minutes() int
        +all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task Task) None
        +label() str
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +int weekday
        +date due_date
        +date starts_on
        +time fixed_time
        +bool completed
        +Pet pet
        +mark_complete() None
        +mark_incomplete() None
        +is_pinned() bool
        +is_due_on(day date) bool
        +next_occurrence_date(on date) date
        +next_occurrence(on date) Task
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +str reason
        +describe() str
    }

    class SkippedTask {
        +Task task
        +str reason
        +describe() str
    }

    class Schedule {
        +Owner owner
        +date day
        +list~ScheduledTask~ scheduled
        +list~SkippedTask~ skipped
        +generate() None
        +explain() str
        +total_minutes() int
    }

    class Scheduler {
        +Owner owner
        +all_tasks() list~Task~
        +pending_tasks() list~Task~
        +completed_tasks() list~Task~
        +tasks_due_on(day date) list~Task~
        +tasks_for_pet(pet Pet) list~Task~
        +plan_for(day date) Schedule
        +sort_by_time(tasks list) list~Task~
        +sort_by_priority(tasks list) list~Task~
        +filter_by_status(completed bool) list~Task~
        +filter_by_pet(pet_name str) list~Task~
        +filter_by_priority(priority Priority) list~Task~
        +complete_task(task Task, on date) Task
        +find_conflicts(day date) list~str~
        +has_conflicts(day date) bool
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Task --> Priority : uses
    Task --> Frequency : uses
    Scheduler "1" --> "1" Owner : reads tasks from
    Scheduler ..> Schedule : produces
    Schedule "1" --> "1" Owner : plans for
    Schedule "1" --> "*" ScheduledTask : contains
    Schedule "1" --> "*" SkippedTask : contains
    ScheduledTask "1" --> "1" Task : wraps
    SkippedTask "1" --> "1" Task : wraps
